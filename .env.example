# Server
PORT=5000
NODE_ENV=development

# Database — MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/HR-DB

# Auth — secret used to sign JWTs stored in httpOnly cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# CORS — allowed origin(s) of the frontend (comma-separated for more than one;
# each must match a browser origin exactly: scheme + host + port).
FRONTEND_URL=http://localhost:3000

# Session cookie. Leave unset for development. When the API is served from a
# different hostname than the UI (api.example.com vs app.example.com) the cookie
# must be COOKIE_SAME_SITE=none and COOKIE_SECURE=true, and both origins HTTPS.
# COOKIE_SAME_SITE=lax|strict|none
# COOKIE_SECURE=true|false
# SESSION_DAYS=7

# Behind a reverse proxy or load balancer, set the number of proxy hops so rate
# limiting sees the client IP instead of the proxy's. Leave unset when the app is
# reached directly.
# TRUST_PROXY=1

# Rate limiting, per IP. Raise the ceiling for a large office behind one NAT.
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_MAX=3000

# Transactional email (invites, password resets). Without these the API still
# works: invites return their link, password resets return the token in
# development, and the UI says delivery is not configured instead of claiming it
# sent something. Create a key at https://resend.com and verify the sender.
# RESEND_API_KEY=re_...
# MAIL_FROM="HR Portal <hr@example.com>"

# Document storage. Local disk is the default and fine for development; on a host
# with ephemeral disk, set the S3 variables so uploads survive a redeploy.
# UPLOAD_DIR=./uploads
# DOCUMENT_RETENTION_DAYS=365
# S3_BUCKET=hr-portal-documents
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false
# DOWNLOAD_URL_TTL_SECONDS=300
